# Caddy : interface statique, /api et /hubs vers l'API (WebSocket compris).
# Variables :
#   SITE_ADDRESS  le nom du site, avec HTTPS automatique (ex. app.mondomaine.com) ; « :8080 » sur Render (Render fait
#                 déjà le HTTPS devant) ; « :80 » pour un essai local en HTTP ;
#   API_UPSTREAM  l'adresse de l'API (par défaut api:8080, le service de deploy/docker-compose.yml ; sur Render
#                 l'adresse interne du Private Service, ex. hawala-api:8080, par le réseau privé) ;
#   ACME_EMAIL    l'email pour Let's Encrypt (obligatoire, même s'il ne sert pas sur Render).
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	@backend path /api/* /hubs/*
	handle @backend {
		# Caddy ajoute X-Forwarded-For / X-Forwarded-Proto pour l'API.
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv
		# Fichiers à nom versionné : gardés un an. Tout le reste (index.html, sw.js, registerSW.js,
		# manifest.webmanifest, icônes) est revalidé à chaque fois, sinon les mises à jour de l'app n'arrivent pas.
		@versioned path /assets/*
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
