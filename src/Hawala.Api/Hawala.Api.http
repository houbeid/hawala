# Requêtes de test manuel (VS Code : extension REST Client ; Visual Studio / Rider : natif).
# Port : celui de launchSettings.json (profil http). À changer si « Now listening on » affiche autre chose.
@host = http://localhost:5215
@api = {{host}}/api/v1/auth
@users = {{host}}/api/v1/users

# Coller ici le accessToken reçu à la connexion (compte au mot de passe déjà changé).
@token = COLLER_LE_ACCESS_TOKEN_ICI

# Coller ici l'id d'un compte (renvoyé à la création ou lu dans la liste).
@userId = COLLER_L_ID_DU_COMPTE_ICI

# Coller ici l'id d'une agence (lu dans GET /agencies).
@agencyId = COLLER_L_ID_DE_L_AGENCE_ICI

### Connexion (email ou téléphone dans le même champ)
POST {{api}}/login
Content-Type: application/json

{
  "login": "remplace-par-l-email-du-seed",
  "password": "remplace-par-le-mot-de-passe-temporaire"
}

### Changement du mot de passe temporaire
POST {{api}}/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "remplace-par-le-mot-de-passe-temporaire",
  "newPassword": "remplace-par-un-nouveau-mot-de-passe-1"
}

### Compte connecté
GET {{api}}/me
Authorization: Bearer {{token}}

### Rafraîchissement (le cookie hawala_refresh est envoyé automatiquement)
POST {{api}}/refresh

### Déconnexion
POST {{api}}/logout

### Liste des agences
GET {{host}}/api/v1/agencies
Authorization: Bearer {{token}}

### Changer la couleur d'une agence (Superviseur, permission agencies.manage ; couleur unique par agence)
POST {{host}}/api/v1/agencies/{{agencyId}}/change-color
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "color": "#1E8E3E"
}

# --- Gestion des comptes (Superviseur, permission users.manage) -----------

### Créer un compte (le mot de passe temporaire n'est affiché qu'une fois)
POST {{users}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "agent.fictif@example.com",
  "phone": "+221 77 000 00 00",
  "fullName": "Agent Fictif",
  "role": "Agent",
  "agencyId": "{{agencyId}}"
}

### Lister les comptes (tous les filtres sont facultatifs)
GET {{users}}?role=Agent&status=Active&search=fictif
Authorization: Bearer {{token}}

### Fiche d'un compte
GET {{users}}/{{userId}}
Authorization: Bearer {{token}}

### Modifier le profil (état complet : un téléphone absent est retiré)
PUT {{users}}/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "agent.fictif@example.com",
  "phone": "+221 77 000 00 00",
  "fullName": "Agent Fictif Corrigé"
}

### Bloquer un compte (coupe ses sessions)
POST {{users}}/{{userId}}/block
Authorization: Bearer {{token}}

### Débloquer un compte (nouveau mot de passe temporaire, affiché une fois)
POST {{users}}/{{userId}}/unblock
Authorization: Bearer {{token}}

### Changer le rôle (agencyId absent pour un Superviseur)
POST {{users}}/{{userId}}/change-role
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "Cashier",
  "agencyId": "{{agencyId}}"
}

### Changer d'agence
POST {{users}}/{{userId}}/change-agency
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "agencyId": "{{agencyId}}"
}

### Réinitialiser le mot de passe (nouveau mot de passe temporaire, affiché une fois)
POST {{users}}/{{userId}}/reset-password
Authorization: Bearer {{token}}

# --- Comptes de trésorerie (caisses, banques, wallets) --------------------
# Lecture : tout compte connecté, dans son agence (les deux pour le Superviseur) ; soldes avec cash.budget.read.
# Écriture : Superviseur seulement (treasury.manage).

@treasuryId = COLLER_L_ID_DU_COMPTE_DE_TRESORERIE_ICI

### Créer un compte de trésorerie (type : Cash, Bank ou Wallet ; devise = celle de l'agence)
POST {{host}}/api/v1/treasury-accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Caisse principale",
  "type": "Cash",
  "agencyId": "{{agencyId}}"
}

### Lister les comptes de trésorerie (filtres facultatifs)
GET {{host}}/api/v1/treasury-accounts?type=Cash&includeInactive=false
Authorization: Bearer {{token}}

### Fiche d'un compte de trésorerie
GET {{host}}/api/v1/treasury-accounts/{{treasuryId}}
Authorization: Bearer {{token}}

### Renommer (nom unique dans l'agence)
PUT {{host}}/api/v1/treasury-accounts/{{treasuryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Caisse guichet 1"
}

### Désactiver (solde nul seulement)
POST {{host}}/api/v1/treasury-accounts/{{treasuryId}}/deactivate
Authorization: Bearer {{token}}

### Réactiver
POST {{host}}/api/v1/treasury-accounts/{{treasuryId}}/reactivate
Authorization: Bearer {{token}}

# --- Taux du jour (5 000 FCFA = ? MRO) --------------------------------------
# Fixer : Superviseur (rates.set_daily). Lire : tout compte connecté ; prix d'achat seulement avec profit.view.

### Fixer ou changer les taux d'une journée
PUT {{host}}/api/v1/rates/2026-10-20
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "purchaseRate": 3600,
  "saleRate": 3650
}

### Taux du jour
GET {{host}}/api/v1/rates/today
Authorization: Bearer {{token}}

### Historique (mois en cours par défaut)
GET {{host}}/api/v1/rates?from=2026-10-01&to=2026-10-31
Authorization: Bearer {{token}}

# --- Transferts ---------------------------------------------------------------
# Créer : Superviseur et Agent (transfers.create). Le taux du jour de la date d'opération doit être fixé.
# Un agent crée depuis son agence (sourceAgencyId facultatif) ; le Superviseur indique sourceAgencyId.
# Changer l'Idempotency-Key à chaque nouveau transfert ; la même clé renvoie le transfert déjà créé (200, sans code).

@destinationAgencyId = COLLER_L_ID_DE_L_AGENCE_DE_DESTINATION_ICI

### Créer un transfert payé comptant (répartition dans la devise de l'agence d'envoi)
POST {{host}}/api/v1/transfers
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: exemple-0001

{
  "destinationAgencyId": "{{destinationAgencyId}}",
  "amountXof": 5000000,
  "senderInfo": "Expéditeur fictif 22200000",
  "beneficiaryInfo": "Bénéficiaire fictif 770000000",
  "note": "Note fictive",
  "payments": [
    { "treasuryAccountId": "{{treasuryId}}", "amount": 3650000 }
  ]
}

@partyId = COLLER_L_ID_DU_TIERS_ICI

### Créer un transfert en partie à crédit (transfers.credit) : 3 650 000 MRO, 1 000 000 payés, 2 650 000 sur le tiers
POST {{host}}/api/v1/transfers
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: exemple-0002

{
  "destinationAgencyId": "{{destinationAgencyId}}",
  "amountXof": 5000000,
  "senderInfo": "Expéditeur fictif 22200000",
  "beneficiaryInfo": "Bénéficiaire fictif 770000000",
  "payments": [
    { "treasuryAccountId": "{{treasuryId}}", "amount": 1000000 }
  ],
  "creditPartyId": "{{partyId}}"
}

### Lister les transferts (aujourd'hui par défaut ; 50 par page)
GET {{host}}/api/v1/transfers?status=NotDelivered&direction=Sent&page=1
Authorization: Bearer {{token}}

### Lister les transferts d'une période, avec recherche
GET {{host}}/api/v1/transfers?from=2026-10-01&to=2026-10-31&search=fictif
Authorization: Bearer {{token}}

@transferId = COLLER_L_ID_DU_TRANSFERT_ICI

### Fiche d'un transfert
GET {{host}}/api/v1/transfers/{{transferId}}
Authorization: Bearer {{token}}

### Livrer un transfert (agence de destination ; code donné par le bénéficiaire ; total = montant à livrer)
POST {{host}}/api/v1/transfers/{{transferId}}/deliver
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "123456",
  "payments": [
    { "treasuryAccountId": "{{treasuryId}}", "amount": 5000000 }
  ],
  "note": "Note fictive"
}

### Cartes de l'écran des transferts (Superviseur ; aujourd'hui par défaut)
GET {{host}}/api/v1/transfers/summary?agencyId={{agencyId}}
Authorization: Bearer {{token}}

### Annuler un transfert non livré (Superviseur ; motif obligatoire)
POST {{host}}/api/v1/transfers/{{transferId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Motif fictif"
}
