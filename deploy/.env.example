# Modèle du fichier .env (copier en « .env » à côté de docker-compose.yml, puis remplir).
# .env n'est JAMAIS versionné. Chaque environnement (préprod, prod) a ses PROPRES secrets.
# Générer une valeur aléatoire sur le serveur :  openssl rand -hex 24   (ou -base64 32 / 48, voir chaque ligne)

# Environnement de l'API : Staging pour la préprod, Production pour la prod.
ASPNETCORE_ENVIRONMENT=Staging

# Adresse du site, sans « https:// » (Caddy obtient le certificat tout seul). Essai local en HTTP : « :80 ».
SITE_ADDRESS=hawala-preprod.duckdns.org
# Email pour Let's Encrypt (avis d'expiration des certificats) ; obligatoire, même pour un essai local.
ACME_EMAIL=

# Mot de passe de la base : openssl rand -hex 24  (lettres et chiffres seulement)
POSTGRES_PASSWORD=

# Clé de signature des jetons, 32 octets au moins : openssl rand -base64 48
JWT_SIGNING_KEY=

# Clé de chiffrement des téléphones, NNI et pièces d'identité, 32 octets : openssl rand -base64 32
# À SAUVEGARDER HORS DU SERVEUR : sans elle, une sauvegarde de la base est illisible pour ces champs.
ENCRYPTION_KEY=

# Premier Superviseur, créé au premier démarrage si aucun n'existe (mot de passe temporaire, changé à la connexion).
SEED_SUPERVISOR_EMAIL=
SEED_SUPERVISOR_NAME=
SEED_SUPERVISOR_PASSWORD=

# Ports publiés sur la machine (laisser 80 / 443 sur le serveur ; changer seulement pour un essai local).
HTTP_PORT=80
HTTPS_PORT=443
